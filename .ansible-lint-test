---
# Test configuration with some rules enabled
strict: true
use_default_rules: true
skip_list:
  # Keep most disabled for now, enable one by one
  - experimental
  - package-latest
  - no-tabs
  - fqcn-builtins
  - name[template]
  - fqcn[action]
  - role-name
  - key-order[task]
  - no-free-form
  - name[play]
  - var-naming[no-role-prefix]
  - risky-file-permissions
  - risky-shell-pipe
  - command-instead-of-shell
  - command-instead-of-module
  - ignore-errors
  - jinja[spacing]
  # Enable these to see the warnings:
  # - no-changed-when
  # - no-handler
  # - unnamed-task
