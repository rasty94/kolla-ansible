# Application
APP_NAME=Kolla-Control
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database Configuration
DATABASE_URL=mysql+aiomysql://kolla_control:kolla_control_dev@localhost:3306/kolla_control
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Celery
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=false

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Kolla-Ansible
KOLLA_ANSIBLE_PATH=/usr/local/share/kolla-ansible
KOLLA_CONFIG_PATH=/etc/kolla
ANSIBLE_INVENTORY_PATH=/etc/kolla/inventory

# Foreman Integration
FOREMAN_ENABLED=false
FOREMAN_URL=https://foreman.example.com
FOREMAN_API_USER=admin
FOREMAN_API_PASSWORD=changeme
FOREMAN_VERIFY_SSL=true

# Prometheus Integration
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://localhost:9090

# Grafana Integration
GRAFANA_ENABLED=true
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/kolla-control/app.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9091
